NODE_ENV=development

DB_PORT=5432
DB_HOST=localhost
DB_NAME=propify
DB_USER=usuario_bd
DB_PASSWORD=clave_bd
PUERTO_SERVIDOR=3000

# Mínimo 32 caracteres. NUNCA copies este valor: genera uno propio con:
# openssl rand -base64 48
CLAVE_SECRETA=GENERA_TU_PROPIO_SECRETO_NO_USES_ESTE_VALOR
JWT_TTL=1h
FRONTEND_URL=http://localhost:5173

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=usuario@example.com
MAIL_PASS=clave_correo
MAIL_FROM=usuario@example.com
MAIL_TO=usuario@example.com

# Opcionales — si se definen, SeedService crea un usuario admin al arrancar.
# Sin contraseña fija, se genera una aleatoria y se imprime UNA vez en el log.
# SEED_ADMIN_EMAIL=admin@propify.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Administrador Propify
